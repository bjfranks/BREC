#!/bin/bash
#SBATCH --partition=gpuidle
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:1
#SBATCH --mem=48G
#SBATCH -t 2-00:00:00

module load anaconda3/latest
. $ANACONDA_HOME/etc/profile.d/conda.sh

date
hostname
pwd

conda activate brec

cd $SLURM_SUBMIT_DIR
pwd

echo $@
eval $@


echo "All done in sbatch."
date
